{
  "name": "@ishiki/root",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "docs",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "yakumo build",
    "bump": "bun scripts/release.ts bump",
    "clean": "yakumo clean",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "husky",
    "publish": "bun scripts/release.ts publish",
    "test": "vitest run"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.4",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.77.0",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "yakumo": "^4.0.0",
    "yakumo-client": "workspace:*",
    "yakumo-esbuild": "^4.0.0",
    "yakumo-tsc": "^4.0.0",
    "yakumo-vitest": "^2.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js,jsx}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.json": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "yarn@4.12.0"
}
