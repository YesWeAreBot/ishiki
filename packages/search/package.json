{
  "name": "koishi-plugin-ishiki-search",
  "version": "0.0.1",
  "description": "web search tools for Ishiki",
  "keywords": [
    "agent",
    "chatbot",
    "extension",
    "ishiki",
    "koishi",
    "plugin",
    "search",
    "web"
  ],
  "homepage": "https://github.com/YesWeAreBot/ishiki/blob/main/packages/search",
  "bugs": {
    "url": "https://github.com/YesWeAreBot/ishiki/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YesWeAreBot/ishiki.git",
    "directory": "packages/search"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
