    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "koishi": "^4.18.11",
    "koishi-plugin-ishiki": ">=0.0.5 <0.1.0"
  },
  "peerDependencies": {
    "koishi": "^4.18.11",
    "koishi-plugin-ishiki": ">=0.0.6 <0.1.0"
  },
  "koishi": {
    "description": {
      "zh": "为 Ishiki 提供网络搜索能力",
      "en": "Web search for Ishiki"
    },
    "service": {
      "required": [
        "ishiki"
      ]
    }
