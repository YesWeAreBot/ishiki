{
  "name": "koishi-plugin-ishiki",
  "version": "0.0.4",
  "description": "Ishiki core runtime for Koishi: agent loop, model gateway, profiles, engines, tools and resources",
  "keywords": [
    "agent",
    "chatbot",
    "ishiki",
    "koishi",
    "plugin"
  ],
  "homepage": "https://github.com/YesWeAreBot/ishiki/blob/main/packages/koishi-plugin-ishiki",
  "bugs": {
    "url": "https://github.com/YesWeAreBot/ishiki/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YesWeAreBot/ishiki.git",
    "directory": "packages/koishi-plugin-ishiki"
  },
  "files": [
    "dist",
    "lib",
    "resources"
  ],
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@ai-sdk-tool/parser": "5.1.6",
    "@earendil-works/pi-codemode": "1.4.0",
    "@huggingface/jinja": "^0.5.10",
    "@koishijs/console": "^5.30.11",
    "@satorijs/element": "^3.2.0",
    "@yesimagent/core": "0.0.9",
    "@yesimagent/gateway": "0.0.9",
    "reggol": "^1.7.1",
    "schemastery": "^3.18.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@koishijs/client": "^5.30.11",
    "@koishijs/plugin-console": "^5.30.11",
    "@koishijs/plugin-database-memory": "^3.7.0",
    "@koishijs/plugin-server": "^3.2.9",
    "koishi": "^4.18.11",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "koishi": "^4.18.11"
  },
  "koishi": {
    "description": {
      "zh": "Ishiki 核心运行时：Agent 循环、模型网关、profile、引擎机制与工具资源",
      "en": "Ishiki core runtime: agent loop, model gateway, profiles, engines, tools and resources"
    },
    "service": {
      "implements": [
        "ishiki"
      ],
      "optional": [
        "console"
      ]
    }
  },
  "yakumo": {
    "client": {
      "build": {
        "rollupOptions": {
          "output": {
            "paths": {
              "@koishijs/client": "../client.js",
              "vue": "../vue.js",
              "vue-router": "../vue-router.js",
              "@vueuse/core": "../vueuse.js"
            }
          }
        }
      }
    }
  }
}
