{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "target": "ES2022"
  },
  "include": ["index.ts", "env.d.ts", "src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"]
}
