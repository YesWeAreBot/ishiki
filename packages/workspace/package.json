{
  "name": "koishi-plugin-ishiki-workspace",
  "version": "0.0.2",
  "description": "Workspace tools for Ishiki: sandboxed or native shell, file tools and skills",
  "keywords": [
    "agent",
    "chatbot",
    "extension",
    "ishiki",
    "koishi",
    "plugin",
    "workspace"
  ],
  "homepage": "https://github.com/YesWeAreBot/ishiki/blob/main/packages/workspace",
  "bugs": {
    "url": "https://github.com/YesWeAreBot/ishiki/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YesWeAreBot/ishiki.git",
    "directory": "packages/workspace"
  },
  "files": [
    "lib"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "just-bash": "3.6.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "koishi": "^4.18.11",
    "koishi-plugin-ishiki": ">=0.0.2 <0.1.0"
  },
  "peerDependencies": {
    "koishi": "^4.18.11",
    "koishi-plugin-ishiki": ">=0.0.1 <0.1.0"
  },
  "koishi": {
    "description": {
      "zh": "工作区工具插件",
      "en": "Workspace tools plugin"
    },
    "service": {
      "required": [
        "ishiki"
      ]
    }
  }
}
