{
  "name": "koishi-plugin-ishiki-onebot-actions",
  "version": "0.0.5",
  "description": "OneBot v11 action catalog and tools for Ishiki: group, file, history and profile operations",
  "keywords": [
    "agent",
    "chatbot",
    "extension",
    "ishiki",
    "koishi",
    "onebot",
    "plugin"
  ],
  "homepage": "https://github.com/YesWeAreBot/ishiki/blob/main/packages/onebot-actions",
  "bugs": {
    "url": "https://github.com/YesWeAreBot/ishiki/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YesWeAreBot/ishiki.git",
    "directory": "packages/onebot-actions"
  },
  "files": [
    "lib"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "catalog": "node scripts/generate-catalog.mjs",
    "catalog:check": "node scripts/generate-catalog.mjs --check"
  },
  "devDependencies": {
    "@koishijs/plugin-server": "^3.2.9",
    "koishi": "^4.18.11",
    "koishi-plugin-ishiki": ">=0.0.5 <0.1.0"
  },
  "peerDependencies": {
    "koishi": "^4.18.11",
    "koishi-plugin-ishiki": ">=0.0.5 <0.1.0"
  },
  "koishi": {
    "description": {
      "zh": "OneBot v11 动作目录与调用工具",
      "en": "OneBot v11 action catalog and tools"
    },
    "service": {
      "required": [
        "ishiki"
      ],
      "optional": [
        "server"
      ]
    }
  }
}
