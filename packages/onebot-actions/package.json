{
  "name": "koishi-plugin-ishiki-onebot-actions",
  "version": "0.0.6",
  "description": "OneBot actions for Ishiki, supporting NapCat, SnowLuma and LLBot",
  "keywords": [
    "agent",
    "chatbot",
    "extension",
    "ishiki",
    "koishi",
    "onebot",
    "plugin"
  ],
  "homepage": "https://github.com/YesWeAreBot/ishiki/blob/main/packages/onebot-actions",
  "bugs": {
    "url": "https://github.com/YesWeAreBot/ishiki/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YesWeAreBot/ishiki.git",
    "directory": "packages/onebot-actions"
  },
  "files": [
    "lib"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "catalog": "node scripts/generate-catalog.mjs",
    "catalog:check": "node scripts/generate-catalog.mjs --check"
  },
  "devDependencies": {
    "@koishijs/plugin-server": "^3.2.9",
    "koishi": "^4.18.11",
    "koishi-plugin-ishiki": ">=0.0.6 <0.1.0"
  },
  "peerDependencies": {
    "koishi": "^4.18.11",
    "koishi-plugin-ishiki": ">=0.0.6 <0.1.0"
  },
  "koishi": {
    "description": {
      "zh": "为 Ishiki 提供 OneBot 客户端操作能力，支持 NapCat、SnowLuma、LLBot 等兼容 OneBot 协议的后端",
      "en": "OneBot client operations for Ishiki, supporting NapCat, SnowLuma, LLBot and other OneBot-compatible backends"
    },
    "service": {
      "required": [
        "ishiki"
      ],
      "optional": [
        "server"
      ]
    }
  }
}
